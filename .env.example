# Clauree Wispbyte Environment Variables
# Put these in your .env file, or in the Wispbyte Server -> Startup / Environment Variables panel.

# Your unique backend authentication token for the FastAPI endpoints
WISPBYTE_API_KEY=your_real_backend_key_here

# Your xAI / Grok developer API key used for prompt engineering generation
GROK_API_KEY=xai-your_real_grok_key_here

# Optional: Grok model name
GROK_MODEL=grok-3

# The port Wispbyte assigned to your server (the number in your public URL)
PORT=14479
