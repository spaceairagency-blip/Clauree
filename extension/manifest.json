{
  "manifest_version": 3,
  "name": "Clauree",
  "version": "1.0.0",
  "description": "Usage strip, limit forecast, cutoff tags and prompt optimizer for claude.ai",
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "clauree.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "clauree@__HOST__",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
